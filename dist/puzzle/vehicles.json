[{"width":660,"height":292,"parts":[{"x":0,"h":106.0,"id":"tracks","w":349.0,"y":185,"file":"excavator/art/tracks.png","name":"履带底盘"},{"x":2,"h":190.0,"id":"cab","w":324.0,"y":2,"file":"excavator/art/cab.png","name":"驾驶室和车身"},{"x":287.04,"h":118.5,"id":"boom","w":187.23000000000002,"y":31.409999999999997,"file":"excavator/art/boom.png","name":"大臂"},{"x":436.35,"h":60.830000000000005,"id":"stick","w":169.85,"y":30.620000000000005,"file":"excavator/art/stick.png","name":"斗杆"},{"x":560.38,"h":104.28,"id":"bucket","w":97.17,"y":45.629999999999995,"file":"excavator/art/bucket.png","name":"铲斗"}],"layers":["tracks","cab","boom","stick","bucket"],"id":"excavator","name":"挖掘机","intro":"intro","number":1,"voiceLines":{"intro":"挖掘机用铲斗挖土。一起拼一辆吧！","tracks":"履带带着车身前进。","cab":"驾驶员在这里操纵挖掘机。","boom":"大臂抬起整条机械臂。","stick":"斗杆伸出去，把铲斗拉回来。","bucket":"铲斗用斗齿挖起泥土。"}},{"id":"wheel-trencher","name":"轮式挖沟机","width":1524,"height":817,"layers":["trencherBody","trencherCab","trencherWheel","trencherArm"],"parts":[{"id":"trencherBody","name":"轮式底盘","file":"puzzle/wheel-trencher/trencherBody.webp","x":0,"y":190,"w":948,"h":627},{"id":"trencherCab","name":"驾驶室","file":"puzzle/wheel-trencher/trencherCab.webp","x":248,"y":0,"w":479,"h":421},{"id":"trencherWheel","name":"切削轮","file":"puzzle/wheel-trencher/trencherWheel.webp","x":965,"y":180,"w":559,"h":590},{"id":"trencherArm","name":"摆臂与油缸","file":"puzzle/wheel-trencher/trencherArm.webp","x":709,"y":183,"w":716,"h":364}],"intro":"trencherIntro","number":2,"voiceLines":{"trencherIntro":"这是轮式挖沟机。车后的切削轮转起来，就能在地上挖出一条沟。","trencherBody":"这是轮式底盘，大轮胎托着车身向前走。","trencherCab":"这是驾驶室，司机坐在这里开车。","trencherWheel":"这是切削轮。轮边的钢齿转起来，把泥土切开。","trencherArm":"这是摆臂，它能抬高、放低后面的切削轮。"}},{"id":"tipper","name":"翻斗车","width":1711,"height":884,"layers":["truckframe","truckcab","trucklift","truckbed"],"parts":[{"id":"truckframe","name":"轮式底盘","file":"puzzle/tipper/truckframe.webp","x":0,"y":260,"w":1670,"h":624},{"id":"truckcab","name":"驾驶室","file":"puzzle/tipper/truckcab.webp","x":14,"y":9,"w":589,"h":636},{"id":"trucklift","name":"液压油缸","file":"puzzle/tipper/trucklift.webp","x":661,"y":255,"w":230,"h":333},{"id":"truckbed","name":"翻斗车厢","file":"puzzle/tipper/truckbed.webp","x":515,"y":0,"w":1196,"h":532}],"intro":"truckintro","number":3,"voiceLines":{"truckintro":"翻斗车，用车厢运泥土。","truckframe":"轮子带着底盘向前开。","truckcab":"这里是驾驶室。","trucklift":"这是液压油缸。它伸长时，车厢就抬起来啦。","truckbed":"车厢举起来，就能卸土。"}},{"id":"mixer","name":"混凝土搅拌车","width":1728,"height":822,"layers":["mixerFrame","mixerCab","mixerDrum","mixerChute"],"parts":[{"id":"mixerFrame","name":"轮式底盘","file":"puzzle/mixer/mixerFrame.webp","x":0,"y":460,"w":1487,"h":362},{"id":"mixerCab","name":"驾驶室","file":"puzzle/mixer/mixerCab.webp","x":19,"y":1,"w":539,"h":587},{"id":"mixerDrum","name":"搅拌筒","file":"puzzle/mixer/mixerDrum.webp","x":557,"y":0,"w":825,"h":489},{"id":"mixerChute","name":"卸料槽","file":"puzzle/mixer/mixerChute.webp","x":1304,"y":48,"w":424,"h":577}],"intro":"mixerIntro","number":4,"voiceLines":{"mixerIntro":"这是混凝土搅拌车。它一边运送混凝土，一边转动大筒。","mixerFrame":"这是轮式底盘，托着沉甸甸的搅拌筒。","mixerCab":"这是驾驶室，司机坐在这里开车。","mixerDrum":"这是搅拌筒，转起来就能搅动里面的混凝土。","mixerChute":"这是卸料槽。混凝土顺着这条斜槽流下来。"}},{"id":"roller","name":"单钢轮压路机","width":1692,"height":823,"layers":["rollerDrive","rollerCab","rollerDrum"],"parts":[{"id":"rollerDrive","name":"后动力底盘","file":"puzzle/roller/rollerDrive.webp","x":675,"y":129,"w":1017,"h":689},{"id":"rollerCab","name":"驾驶室","file":"puzzle/roller/rollerCab.webp","x":695,"y":0,"w":551,"h":478},{"id":"rollerDrum","name":"前钢轮和支架","file":"puzzle/roller/rollerDrum.webp","x":0,"y":293,"w":724,"h":530}],"intro":"rollerIntro","number":5,"voiceLines":{"rollerIntro":"这是单钢轮压路机。它用前面的大钢轮，把松土压紧。","rollerDrive":"这是后动力底盘。发动机带动后轮，让压路机往前走。","rollerCab":"这是驾驶室，司机在这里操纵压路机。","rollerDrum":"这是前钢轮，又宽又重，滚过的地方就压实了。"}},{"id":"loader","name":"轮式装载机（铲车）","width":1856,"height":813,"layers":["wheelLoaderFrame","wheelLoaderCab","wheelLoaderLift"],"parts":[{"id":"wheelLoaderFrame","name":"动力底盘","file":"puzzle/loader/wheelLoaderFrame.webp","x":575,"y":134,"w":1281,"h":679},{"id":"wheelLoaderCab","name":"驾驶室","file":"puzzle/loader/wheelLoaderCab.webp","x":1010,"y":0,"w":499,"h":444},{"id":"wheelLoaderLift","name":"动臂和铲斗","file":"puzzle/loader/wheelLoaderLift.webp","x":0,"y":145,"w":1018,"h":376}],"intro":"wheelLoaderIntro","number":6,"voiceLines":{"wheelLoaderIntro":"这是轮式装载机，也叫铲车。它用铲斗把沙土装上车。","wheelLoaderFrame":"这是动力底盘，发动机带动车轮往前走。","wheelLoaderCab":"这是驾驶室，司机在这里开车、操纵铲斗。","wheelLoaderLift":"这是动臂和铲斗。铲斗兜住沙土，动臂把它举起来。"}},{"id":"bucket-truck","name":"高空作业车","width":1449,"height":1005,"layers":["bucketTruckBase","bucketTruckArm","bucketTruckBasket"],"parts":[{"id":"bucketTruckBase","name":"带支腿的底盘","file":"puzzle/bucket-truck/bucketTruckBase.webp","x":0,"y":309,"w":1327,"h":696},{"id":"bucketTruckArm","name":"折叠臂","file":"puzzle/bucket-truck/bucketTruckArm.webp","x":332,"y":112,"w":799,"h":520},{"id":"bucketTruckBasket","name":"工作斗","file":"puzzle/bucket-truck/bucketTruckBasket.webp","x":1095,"y":0,"w":354,"h":325}],"intro":"bucketTruckIntro","number":7,"voiceLines":{"bucketTruckIntro":"这是高空作业车。它能把工人送到高处，给路灯换灯泡。","bucketTruckBase":"这是作业车底盘。支腿撑住地面，让车站稳。","bucketTruckArm":"这是折叠臂。两段长臂展开，把工作斗举高。","bucketTruckBasket":"这是工作斗。工人站在斗里，就能够到路灯啦。"}},{"id":"crawler-dozer","name":"履带式推土机","width":944,"height":463,"layers":["crawlerDozerCab","crawlerDozerEngine","crawlerDozerBase","crawlerDozerBlade"],"parts":[{"id":"crawlerDozerBase","name":"履带底盘","file":"puzzle/crawler-dozer/crawlerDozerBase.webp","x":218,"y":213,"w":726,"h":250},{"id":"crawlerDozerEngine","name":"发动机舱","file":"puzzle/crawler-dozer/crawlerDozerEngine.webp","x":357,"y":136,"w":319,"h":127},{"id":"crawlerDozerCab","name":"驾驶室","file":"puzzle/crawler-dozer/crawlerDozerCab.webp","x":615,"y":0,"w":296,"h":247},{"id":"crawlerDozerBlade","name":"推土铲和推架","file":"puzzle/crawler-dozer/crawlerDozerBlade.webp","x":0,"y":187,"w":617,"h":276}],"intro":"crawlerDozerIntro","number":8,"voiceLines":{"crawlerDozerIntro":"这是履带式推土机。它放低前面的大铲子，把土往前推。","crawlerDozerBase":"这是履带底盘。两条履带稳稳地托住车身。","crawlerDozerEngine":"这是发动机舱。里面的发动机给推土机提供动力。","crawlerDozerCab":"这是驾驶室，司机坐在这里操纵推土机。","crawlerDozerBlade":"这是推土铲和推架。推架顶着宽宽的铲面，把土推开。"}},{"id":"forklift","name":"叉车","width":1122,"height":604,"layers":["forkliftStation","forkliftMast","forkliftBody","forkliftForks"],"parts":[{"id":"forkliftBody","name":"车身底盘","file":"puzzle/forklift/forkliftBody.webp","x":0,"y":287,"w":665,"h":317},{"id":"forkliftStation","name":"驾驶台","file":"puzzle/forklift/forkliftStation.webp","x":225,"y":66,"w":426,"h":388},{"id":"forkliftMast","name":"升降门架","file":"puzzle/forklift/forkliftMast.webp","x":607,"y":0,"w":143,"h":565},{"id":"forkliftForks","name":"货叉","file":"puzzle/forklift/forkliftForks.webp","x":712,"y":309,"w":410,"h":245}],"intro":"forkliftIntro","number":9,"voiceLines":{"forkliftIntro":"这是叉车。它用两根货叉托起货物，再把货物运走。","forkliftBody":"这是车身底盘。车尾沉甸甸的，帮助叉车保持平衡。","forkliftStation":"这是驾驶台。司机坐在护顶架下面开车。","forkliftMast":"这是门架。货叉沿着它升高、降下。","forkliftForks":"这是货叉。两根叉齿伸进托盘底下，一起托住货物。"}},{"id":"truck-crane","name":"汽车起重机","width":981,"height":668,"layers":["truckCraneCarrier","truckCraneHook","truckCraneBoom","truckCraneTurret"],"parts":[{"id":"truckCraneCarrier","name":"行驶底盘","file":"puzzle/truck-crane/truckCraneCarrier.webp","x":138,"y":291,"w":820,"h":377},{"id":"truckCraneTurret","name":"回转平台","file":"puzzle/truck-crane/truckCraneTurret.webp","x":585,"y":266,"w":396,"h":192},{"id":"truckCraneBoom","name":"伸缩吊臂","file":"puzzle/truck-crane/truckCraneBoom.webp","x":0,"y":0,"w":860,"h":363},{"id":"truckCraneHook","name":"钢丝绳和吊钩","file":"puzzle/truck-crane/truckCraneHook.webp","x":10,"y":43,"w":69,"h":218}],"intro":"truckCraneIntro","number":10,"voiceLines":{"truckCraneIntro":"这是汽车起重机。它能开到工地，把重物吊到高处。","truckCraneCarrier":"这是行驶底盘。到工地后，支腿撑住地面，让车站稳。","truckCraneTurret":"这是回转平台。司机在这里操纵吊臂，转向要吊东西的地方。","truckCraneBoom":"这是伸缩吊臂。一节节伸出去，就能够到更高的地方。","truckCraneHook":"这是吊钩。钢丝绳拉着它，把挂好的重物吊起来。"}},{"id":"vacuum-sweeper","name":"道路清扫车","width":837,"height":491,"layers":["sweeperNozzle","sweeperChassis","sweeperHopper","sweeperBrush"],"parts":[{"id":"sweeperChassis","name":"行驶底盘","file":"puzzle/vacuum-sweeper/sweeperChassis.webp","x":0,"y":0,"w":837,"h":491},{"id":"sweeperHopper","name":"集尘箱","file":"puzzle/vacuum-sweeper/sweeperHopper.webp","x":271,"y":55,"w":565,"h":260},{"id":"sweeperBrush","name":"圆盘刷","file":"puzzle/vacuum-sweeper/sweeperBrush.webp","x":259,"y":330,"w":199,"h":160},{"id":"sweeperNozzle","name":"吸嘴","file":"puzzle/vacuum-sweeper/sweeperNozzle.webp","x":463,"y":301,"w":256,"h":187}],"intro":"sweeperIntro","number":11,"voiceLines":{"sweeperIntro":"这是道路清扫车。它边走边扫，把路面打扫干净。","sweeperChassis":"这是行驶底盘。司机坐在前面，开着车慢慢往前走。","sweeperHopper":"这是集尘箱。扫起来的灰尘和碎纸都装在这里。","sweeperBrush":"这是圆盘刷。刷子转起来，把路边的垃圾扫到车底。","sweeperNozzle":"这是吸嘴。它贴近地面，把垃圾吸进集尘箱。"}},{"id":"pump-truck","name":"混凝土泵车","width":988,"height":720,"layers":["pumpTruckHose","pumpTruckPump","pumpTruckCarrier","pumpTruckBoom"],"parts":[{"id":"pumpTruckCarrier","name":"带支腿的底盘","file":"puzzle/pump-truck/pumpTruckCarrier.webp","x":0,"y":371,"w":732,"h":349},{"id":"pumpTruckPump","name":"泵送装置","file":"puzzle/pump-truck/pumpTruckPump.webp","x":233,"y":378,"w":505,"h":192},{"id":"pumpTruckBoom","name":"布料臂","file":"puzzle/pump-truck/pumpTruckBoom.webp","x":249,"y":0,"w":739,"h":439},{"id":"pumpTruckHose","name":"末端软管","file":"puzzle/pump-truck/pumpTruckHose.webp","x":947,"y":85,"w":39,"h":168}],"intro":"pumpTruckIntro","number":12,"voiceLines":{"pumpTruckIntro":"这是混凝土泵车。它能把混凝土送到楼上。","pumpTruckCarrier":"这是行驶底盘。工作时，支腿伸出来，把车撑稳。","pumpTruckPump":"这是泵送装置。混凝土倒进料斗，泵把它推入管道。","pumpTruckBoom":"这是布料臂。一节节臂架展开，把管道伸到要浇筑的地方。","pumpTruckHose":"这是末端软管。混凝土从这里流出来。"}},{"id":"timber-truck","name":"运木车","width":1205,"height":437,"layers":["timberTrailer","timberTractor","timberBunks"],"parts":[{"id":"timberTractor","name":"牵引车","file":"puzzle/timber-truck/timberTractor.webp","x":0,"y":1,"w":557,"h":436},{"id":"timberTrailer","name":"挂车底盘","file":"puzzle/timber-truck/timberTrailer.webp","x":349,"y":203,"w":856,"h":233},{"id":"timberBunks","name":"载木架","file":"puzzle/timber-truck/timberBunks.webp","x":349,"y":0,"w":852,"h":209}],"intro":"timberIntro","number":13,"voiceLines":{"timberIntro":"这是运木车。它能一次运走好几根长长的原木。","timberTractor":"这是牵引车。它在前面拉着挂车走。","timberTrailer":"这是挂车底盘。前面连着牵引车，后轮托着木材的重量。","timberBunks":"这是载木架。两边的立柱挡住原木，绑带把原木捆牢。"}},{"id":"sprinkler-truck","name":"洒水车","width":1073,"height":380,"parts":[{"id":"sprinklerCab","name":"行驶底盘","file":"puzzle/sprinkler-truck/sprinklerCab.webp","x":5,"y":38,"w":905,"h":342},{"id":"sprinklerTank","name":"储水罐","file":"puzzle/sprinkler-truck/sprinklerTank.webp","x":275,"y":0,"w":665,"h":250},{"id":"sprinklerJets","name":"前冲和侧喷装置","file":"puzzle/sprinkler-truck/sprinklerJets.webp","x":0,"y":281,"w":171,"h":67},{"id":"sprinklerDeck","name":"洒水平台","file":"puzzle/sprinkler-truck/sprinklerDeck.webp","x":876,"y":195,"w":197,"h":96}],"layers":["sprinklerTank","sprinklerCab","sprinklerDeck","sprinklerJets"],"intro":"sprinklerWashIntro","completedView":"puzzle/sprinkler-truck/washing.webp","number":14,"voiceLines":{"sprinklerWashIntro":"这是洒水车。大水罐里的水，能冲洗车前和两边的路面。","sprinklerCab":"这是行驶底盘。司机开着它，沿着道路慢慢走。","sprinklerTank":"这是储水罐。洒水用的清水就装在里面。","sprinklerJets":"这是前冲和侧喷装置。中间的喷头向前冲，两头的喷嘴向两边洒水。","sprinklerDeck":"这是洒水平台。水从喷嘴洒出来，落到路面上。"}},{"id":"log-grapple","name":"抓木机","width":1342,"height":717,"parts":[{"id":"logGrabBase","name":"轮式底盘","file":"puzzle/log-grapple/logGrabBase.webp","x":0,"y":421,"w":735,"h":296},{"id":"logGrabCab","name":"回转平台","file":"puzzle/log-grapple/logGrabCab.webp","x":123,"y":78,"w":510,"h":354},{"id":"logGrabArm","name":"抓臂","file":"puzzle/log-grapple/logGrabArm.webp","x":547,"y":0,"w":696,"h":354},{"id":"logGrabClaw","name":"抓木爪","file":"puzzle/log-grapple/logGrabClaw.webp","x":1087,"y":208,"w":255,"h":274}],"layers":["logGrabBase","logGrabClaw","logGrabArm","logGrabCab"],"intro":"logGrabIntro","number":15,"voiceLines":{"logGrabIntro":"这是抓木机。它用弯弯的抓爪，把原木抱起来。","logGrabBase":"这是轮式底盘。工作时，支腿撑住地面。","logGrabCab":"这是回转平台。司机坐在驾驶室里，能带着抓臂一起转。","logGrabArm":"这是抓臂。它伸出去，再把原木提起来。","logGrabClaw":"这是抓木爪。爪子合拢抱住木头，张开就能放下。"}},{"id":"paving-machine","name":"沥青摊铺机","width":1279,"height":605,"parts":[{"id":"paverBase","name":"履带底盘","file":"puzzle/paving-machine/paverBase.webp","x":261,"y":242,"w":731,"h":351},{"id":"paverStation","name":"操作台","file":"puzzle/paving-machine/paverStation.webp","x":591,"y":0,"w":323,"h":291},{"id":"paverHopper","name":"受料斗","file":"puzzle/paving-machine/paverHopper.webp","x":0,"y":325,"w":392,"h":221},{"id":"paverScreed","name":"熨平板","file":"puzzle/paving-machine/paverScreed.webp","x":955,"y":433,"w":324,"h":172}],"layers":["paverStation","paverHopper","paverScreed","paverBase"],"intro":"paverIntro","number":16,"voiceLines":{"paverIntro":"这是沥青摊铺机。它一边向前走，一边铺出平平的路面。","paverBase":"这是履带底盘。履带带着摊铺机慢慢向前走。","paverStation":"这是操作台。司机坐在这里，控制摊铺机。","paverHopper":"这是受料斗。翻斗车把热乎乎的沥青混合料倒进这里。","paverScreed":"这是熨平板。它在车尾把沥青混合料摊平。"}},{"id":"sewer-vacuum-truck","name":"吸污车","width":1003,"height":460,"parts":[{"id":"sewerVacBase","name":"行驶底盘","file":"puzzle/sewer-vacuum-truck/sewerVacBase.webp","x":0,"y":0,"w":775,"h":460},{"id":"sewerVacTank","name":"密封罐","file":"puzzle/sewer-vacuum-truck/sewerVacTank.webp","x":379,"y":30,"w":446,"h":269},{"id":"sewerVacPump","name":"真空泵","file":"puzzle/sewer-vacuum-truck/sewerVacPump.webp","x":273,"y":220,"w":121,"h":78},{"id":"sewerVacHose","name":"吸污管","file":"puzzle/sewer-vacuum-truck/sewerVacHose.webp","x":796,"y":152,"w":207,"h":289}],"layers":["sewerVacHose","sewerVacPump","sewerVacTank","sewerVacBase"],"intro":"sewerVacIntro","number":17,"voiceLines":{"sewerVacIntro":"这是吸污车。它用粗粗的管子，把井里的污水吸走。","sewerVacBase":"这是行驶底盘。它载着大罐子，开到需要清理的地方。","sewerVacTank":"这是密封罐。吸上来的污水暂时装在里面。","sewerVacPump":"这是真空泵。它抽走罐里的一些空气，污水就能顺着管子流进来。","sewerVacHose":"这是吸污管。管口伸到污水里，污水就从这里被吸进去。"}},{"id":"plow-truck","name":"铲雪车","width":1380,"height":573,"parts":[{"id":"snowPlowCarrier","name":"行驶底盘","file":"puzzle/plow-truck/snowPlowCarrier.webp","x":499,"y":6,"w":816,"h":567},{"id":"snowPlowSpreader","name":"撒布装置","file":"puzzle/plow-truck/snowPlowSpreader.webp","x":894,"y":0,"w":486,"h":345},{"id":"snowPlowBlade","name":"推雪铲","file":"puzzle/plow-truck/snowPlowBlade.webp","x":0,"y":401,"w":549,"h":166}],"layers":["snowPlowSpreader","snowPlowCarrier","snowPlowBlade"],"intro":"snowPlowIntro","number":18,"voiceLines":{"snowPlowIntro":"这是铲雪车。它开过雪地，把路上的积雪推到一边。","snowPlowCarrier":"这是行驶底盘。驾驶室上亮着警示灯，提醒大家留意铲雪车。","snowPlowSpreader":"这是撒布装置。砂粒落到转盘上，再被撒到路面上。","snowPlowBlade":"这是推雪铲。弯弯的铲面把积雪推向路边。"}},{"name":"剪叉式升降车","intro":"scissorLiftIntro","parts":[{"id":"scissorLiftBase","name":"行走底盘","file":"puzzle/scissor-lift/scissorLiftBase.webp","x":0,"y":210,"w":1289,"h":561},{"id":"scissorLiftArms","name":"剪叉臂","file":"puzzle/scissor-lift/scissorLiftArms.webp","x":463,"y":278,"w":723,"h":230},{"id":"scissorLiftDeck","name":"作业平台","file":"puzzle/scissor-lift/scissorLiftDeck.webp","x":411,"y":0,"w":822,"h":292}],"layers":["scissorLiftArms","scissorLiftBase","scissorLiftDeck"],"id":"scissor-lift","width":1289,"height":771,"number":19,"voiceLines":{"scissorLiftIntro":"这是剪叉式升降车。它能把工人送到高处修灯。","scissorLiftBase":"这是行走底盘。车轮转起来，把升降车带到要干活的地方。","scissorLiftArms":"这是剪叉臂。交叉的长臂一撑开，就把平台举高了。","scissorLiftDeck":"这是作业平台。工人站在上面，四周的护栏保护着他们。"}},{"id":"motor-grader","name":"平地机","intro":"motorGraderIntro","width":1427,"height":559,"parts":[{"id":"motorGraderChassis","name":"行走底盘","file":"puzzle/motor-grader/motorGraderChassis.webp","x":0,"y":68,"w":1427,"h":491},{"id":"motorGraderCab","name":"驾驶室","file":"puzzle/motor-grader/motorGraderCab.webp","x":765,"y":0,"w":233,"h":284},{"id":"motorGraderBlade","name":"平地铲刀","file":"puzzle/motor-grader/motorGraderBlade.webp","x":226,"y":285,"w":527,"h":265}],"layers":["motorGraderBlade","motorGraderChassis","motorGraderCab"],"number":20,"voiceLines":{"motorGraderIntro":"这是平地机。车身下面的长铲刀，把高高低低的泥土刮平。","motorGraderChassis":"这是行走底盘。后面的大轮子推着车走，前轮带着车转弯。","motorGraderCab":"这是驾驶室。司机坐在这里，看着前面的铲刀，调节它的高低。","motorGraderBlade":"这是平地铲刀。它斜着刮过地面，把高处的土推向低处。"}},{"id":"skid-steer","name":"滑移装载机","width":934,"height":571,"parts":[{"id":"skidSteerBase","name":"行走底盘","file":"puzzle/skid-steer/skidSteerBase.webp","x":0,"y":155,"w":694,"h":416},{"id":"skidSteerCab","name":"驾驶室","file":"puzzle/skid-steer/skidSteerCab.webp","x":283,"y":0,"w":300,"h":282},{"id":"skidSteerLift","name":"举升臂","file":"puzzle/skid-steer/skidSteerLift.webp","x":80,"y":141,"w":645,"h":419},{"id":"skidSteerBucket","name":"铲斗","file":"puzzle/skid-steer/skidSteerBucket.webp","x":696,"y":431,"w":238,"h":121}],"layers":["skidSteerBase","skidSteerCab","skidSteerLift","skidSteerBucket"],"intro":"skidSteerIntro","number":21,"voiceLines":{"skidSteerIntro":"这是滑移装载机。它能在窄窄的工地上转身，把沙土铲起来。","skidSteerBase":"这是行走底盘。两边的轮子转得一快一慢，车身就转弯啦。","skidSteerCab":"这是驾驶室。司机透过防护网，看着前面的铲斗干活。","skidSteerLift":"这是举升臂。它沿着车身两侧抬起来，把铲斗举高。","skidSteerBucket":"这是铲斗。斗口贴着地面向前铲，沙土就进来啦。"}},{"name":"挖掘装载机","intro":"bhWorkIntro","layers":["bhWorkBase","bhWorkDigger","bhWorkLoader"],"id":"backhoe-loader","width":1474,"height":676,"parts":[{"id":"bhWorkBase","name":"行走底盘","file":"puzzle/backhoe-loader/bhWorkBase.webp","x":344,"y":89,"w":876,"h":587},{"id":"bhWorkLoader","name":"前装载斗","file":"puzzle/backhoe-loader/bhWorkLoader.webp","x":917,"y":391,"w":557,"h":263},{"id":"bhWorkDigger","name":"后挖掘臂","file":"puzzle/backhoe-loader/bhWorkDigger.webp","x":0,"y":0,"w":450,"h":354}],"number":22,"voiceLines":{"bhWorkIntro":"这是挖掘装载机，大家叫它两头忙。前面铲土，后面挖沟。","bhWorkBase":"这是行走底盘。司机坐在驾驶室里，开着四个轮子去工地。","bhWorkLoader":"这是前装载斗。举升臂托起大铲斗，把沙土装进车厢。","bhWorkDigger":"这是后挖掘臂。长臂伸出去，小挖斗弯回来，就能挖出一条沟。"}},{"name":"旋挖钻机","intro":"kellyRigIntro","layers":["kellyRigMast","kellyRigTracks","kellyRigHouse","kellyRigTool"],"id":"rotary-piling-rig","width":731,"height":1125,"parts":[{"id":"kellyRigTracks","name":"履带底盘","file":"puzzle/rotary-piling-rig/kellyRigTracks.webp","x":0,"y":968,"w":473,"h":157},{"id":"kellyRigHouse","name":"回转车身","file":"puzzle/rotary-piling-rig/kellyRigHouse.webp","x":32,"y":736,"w":444,"h":249},{"id":"kellyRigMast","name":"桅杆","file":"puzzle/rotary-piling-rig/kellyRigMast.webp","x":423,"y":0,"w":125,"h":1010},{"id":"kellyRigTool","name":"钻杆和钻斗","file":"puzzle/rotary-piling-rig/kellyRigTool.webp","x":509,"y":336,"w":222,"h":774}],"number":23,"voiceLines":{"kellyRigIntro":"这是旋挖钻机。钻斗转起来，一次一次把土从深孔里带出来。","kellyRigTracks":"这是履带底盘。宽履带托着重重的钻机，在工地上慢慢走。","kellyRigHouse":"这是回转车身。司机坐在这里，让上面的车身转向桩孔。","kellyRigMast":"这是桅杆。它高高地竖起来，让钻杆沿着它上下移动。","kellyRigTool":"这是钻杆和钻斗。钻杆带着钻斗转，钻斗装好土再提上来。"}},{"name":"双头凿岩台车","intro":"twinJumboIntro","layers":["twinJumboCarrier","twinJumboLeft","twinJumboRight"],"id":"twin-drill-jumbo","width":1757,"height":590,"parts":[{"id":"twinJumboCarrier","name":"车身","file":"puzzle/twin-drill-jumbo/twinJumboCarrier.webp","x":0,"y":143,"w":897,"h":447},{"id":"twinJumboLeft","name":"左钻臂","file":"puzzle/twin-drill-jumbo/twinJumboLeft.webp","x":842,"y":0,"w":690,"h":392},{"id":"twinJumboRight","name":"右钻臂","file":"puzzle/twin-drill-jumbo/twinJumboRight.webp","x":772,"y":373,"w":985,"h":146}],"number":24,"voiceLines":{"twinJumboIntro":"这是双头凿岩台车。两条钻臂伸向岩壁，各自找好位置来钻孔。","twinJumboCarrier":"这是车身。它载着司机和两条钻臂，沿着隧道向前开。","twinJumboLeft":"这是左钻臂。它抬起钻头，可以给高处的岩壁钻孔。","twinJumboRight":"这是右钻臂。它把钻头送向前方，能和左钻臂一起干活。"}},{"name":"集装箱正面吊","intro":"portLiftIntro","layers":["portLiftCarrier","portLiftBox","portLiftSpreader","portLiftBoom"],"id":"port-reach-stacker","width":1336,"height":707,"parts":[{"id":"portLiftCarrier","name":"车身","file":"puzzle/port-reach-stacker/portLiftCarrier.webp","x":2,"y":344,"w":814,"h":363},{"id":"portLiftBoom","name":"伸缩臂","file":"puzzle/port-reach-stacker/portLiftBoom.webp","x":47,"y":0,"w":1171,"h":484},{"id":"portLiftSpreader","name":"吊具","file":"puzzle/port-reach-stacker/portLiftSpreader.webp","x":954,"y":247,"w":382,"h":185},{"id":"portLiftBox","name":"集装箱","file":"puzzle/port-reach-stacker/portLiftBox.webp","x":961,"y":377,"w":363,"h":281}],"number":25,"voiceLines":{"portLiftIntro":"这是集装箱正面吊。它伸出长臂，把码头上的集装箱搬起来。","portLiftCarrier":"这是车身。后面的配重和结实的车轮，帮它稳稳地搬箱子。","portLiftBoom":"这是伸缩臂。它抬起来，再向前伸，把吊具送到箱顶。","portLiftSpreader":"这是吊具。四角的锁头扣住集装箱，箱子就能吊起来。","portLiftBox":"这是集装箱。货物装在里面，可以跟着轮船去很远的地方。"}},{"name":"铰接式自卸车","intro":"bendHaulIntro","layers":["bendHaulTractor","bendHaulChassis","bendHaulBody"],"id":"articulated-hauler","width":1709,"height":576,"parts":[{"id":"bendHaulTractor","name":"前车身","file":"puzzle/articulated-hauler/bendHaulTractor.webp","x":0,"y":35,"w":769,"h":541},{"id":"bendHaulChassis","name":"后底盘","file":"puzzle/articulated-hauler/bendHaulChassis.webp","x":705,"y":180,"w":868,"h":396},{"id":"bendHaulBody","name":"翻斗车厢","file":"puzzle/articulated-hauler/bendHaulBody.webp","x":637,"y":0,"w":1072,"h":240}],"number":26,"voiceLines":{"bendHaulIntro":"这是铰接式自卸车。中间的关节一转，车头就带着后车身拐弯。","bendHaulTractor":"这是前车身。司机坐在这里，开着车头带动后面的车厢。","bendHaulChassis":"这是后底盘。它前端的铰接关节，能让车头和后车身转个角度。","bendHaulBody":"这是翻斗车厢。前端向上抬，石块就从车尾滑下来。"}},{"name":"矿用自卸车","intro":"quarryHaulIntro","layers":["quarryHaulBase","quarryHaulCab","quarryHaulRam","quarryHaulBed"],"id":"mining-truck","width":1239,"height":854,"parts":[{"id":"quarryHaulBase","name":"轮式底盘","file":"puzzle/mining-truck/quarryHaulBase.webp","x":0,"y":462,"w":1042,"h":392},{"id":"quarryHaulCab","name":"驾驶平台","file":"puzzle/mining-truck/quarryHaulCab.webp","x":0,"y":298,"w":344,"h":364},{"id":"quarryHaulRam","name":"举升油缸","file":"puzzle/mining-truck/quarryHaulRam.webp","x":538,"y":421,"w":81,"h":147},{"id":"quarryHaulBed","name":"矿石车厢","file":"puzzle/mining-truck/quarryHaulBed.webp","x":125,"y":0,"w":1114,"h":523}],"number":27,"voiceLines":{"quarryHaulIntro":"这是矿用自卸车。它用巨大的车厢，把一车车矿石运出矿坑。","quarryHaulBase":"这是轮式底盘。巨大的轮胎和结实的车架，托着沉沉的矿石。","quarryHaulCab":"这是驾驶平台。司机沿梯子爬上去，就能在高处看清前面的矿道。","quarryHaulRam":"这是举升油缸。油缸伸长，把车厢前端慢慢顶起来。","quarryHaulBed":"这是矿石车厢。前面伸出的挡板像帽檐，能挡住落向驾驶室的碎石。"}},{"name":"联合收割机","intro":"grainCombineIntro","layers":["grainCombineBase","grainCombineBody","grainCombineAuger","grainCombineHeader"],"id":"grain-combine","width":1265,"height":588,"parts":[{"id":"grainCombineBase","name":"行走底盘","file":"puzzle/grain-combine/grainCombineBase.webp","x":574,"y":303,"w":641,"h":279},{"id":"grainCombineBody","name":"收割车身","file":"puzzle/grain-combine/grainCombineBody.webp","x":385,"y":0,"w":841,"h":508},{"id":"grainCombineHeader","name":"割台","file":"puzzle/grain-combine/grainCombineHeader.webp","x":0,"y":371,"w":638,"h":217},{"id":"grainCombineAuger","name":"卸粮筒","file":"puzzle/grain-combine/grainCombineAuger.webp","x":815,"y":128,"w":450,"h":99}],"number":28,"voiceLines":{"grainCombineIntro":"这是联合收割机。它一边割麦子，一边把麦粒收进粮仓。","grainCombineBase":"这是行走底盘。大轮子稳稳地托着车身，在麦田里向前走。","grainCombineBody":"这是收割车身。麦穗送进来，麦粒就从穗上分离出来了。","grainCombineHeader":"这是割台。拨禾轮把麦秆拨向割刀，再把割下的麦子送进车里。","grainCombineAuger":"这是卸粮筒。它伸向旁边的车厢，把粮仓里的麦粒送出去。"}},{"name":"拖拉机带翻转犁","intro":"revPloughIntro","layers":["revPloughTool","revPloughTractor"],"id":"reversible-plough","width":2054,"height":713,"parts":[{"id":"revPloughTractor","name":"拖拉机","file":"puzzle/reversible-plough/revPloughTractor.webp","x":0,"y":0,"w":1136,"h":713},{"id":"revPloughTool","name":"翻转犁","file":"puzzle/reversible-plough/revPloughTool.webp","x":1086,"y":172,"w":968,"h":519}],"number":29,"voiceLines":{"revPloughIntro":"这是带翻转犁的拖拉机。它拉着一排弯犁，把泥土一垄垄翻开。","revPloughTractor":"这是拖拉机。大轮子带着车身向前走，车尾的悬挂拉着犁。","revPloughTool":"这是翻转犁。弯弯的犁面把土翻过来，另一组犁面朝上。"}},{"name":"乘坐式插秧机","intro":"paddySeatIntro","layers":["paddySeatClaws","paddySeatRack","paddySeatStation","paddySeatBase"],"id":"rice-transplanter","width":1528,"height":605,"parts":[{"id":"paddySeatBase","name":"水田底盘","file":"puzzle/rice-transplanter/paddySeatBase.webp","x":0,"y":170,"w":899,"h":435},{"id":"paddySeatStation","name":"驾驶台","file":"puzzle/rice-transplanter/paddySeatStation.webp","x":252,"y":117,"w":306,"h":225},{"id":"paddySeatRack","name":"秧苗架","file":"puzzle/rice-transplanter/paddySeatRack.webp","x":975,"y":0,"w":553,"h":296},{"id":"paddySeatClaws","name":"插秧机构","file":"puzzle/rice-transplanter/paddySeatClaws.webp","x":854,"y":167,"w":659,"h":355}],"number":30,"voiceLines":{"paddySeatIntro":"这是乘坐式插秧机。它走在水田里，把嫩绿的秧苗一株株插进泥里。","paddySeatBase":"这是水田底盘。细细的高轮子转起来，带着车子走过水田。","paddySeatStation":"这是驾驶台。司机坐在座椅上，扶着方向盘沿着秧行往前开。","paddySeatRack":"这是秧苗架。一片片带着泥的秧苗，顺着斜架慢慢往下送。","paddySeatClaws":"这是插秧机构。插秧爪轮流取下秧苗，把它们插进泥里。"}},{"name":"圆捆打捆机","intro":"fieldBaleIntro","layers":["fieldBaleRoll","fieldBaleChamber","fieldBaleTractor","fieldBalePickup"],"id":"round-baler","width":1880,"height":529,"parts":[{"id":"fieldBaleTractor","name":"牵引车","file":"puzzle/round-baler/fieldBaleTractor.webp","x":0,"y":0,"w":785,"h":529},{"id":"fieldBalePickup","name":"捡拾器","file":"puzzle/round-baler/fieldBalePickup.webp","x":984,"y":362,"w":254,"h":120},{"id":"fieldBaleChamber","name":"打捆机身","file":"puzzle/round-baler/fieldBaleChamber.webp","x":736,"y":82,"w":935,"h":441},{"id":"fieldBaleRoll","name":"圆草捆","file":"puzzle/round-baler/fieldBaleRoll.webp","x":1570,"y":264,"w":310,"h":260}],"number":31,"voiceLines":{"fieldBaleIntro":"这是圆捆打捆机。拖拉机拉着它捡干草，把草卷成大圆捆。","fieldBaleTractor":"这是牵引车。它拉着打捆机沿着草条前进。","fieldBalePickup":"这是捡拾器。一排排弯齿转起来，把地上的干草送进机身。","fieldBaleChamber":"这是打捆机身。干草在里面越卷越紧，后盖打开就能卸下草捆。","fieldBaleRoll":"这是圆草捆。干草卷紧了，圆圆的一捆方便运回农场。"}},{"name":"后装压缩式垃圾车","intro":"refuseRearIntro","layers":["refuseRearChassis","refuseRearBody","refuseRearPacker"],"id":"rear-load-refuse-truck","width":1475,"height":526,"parts":[{"id":"refuseRearChassis","name":"带驾驶室的底盘","file":"puzzle/rear-load-refuse-truck/refuseRearChassis.webp","x":0,"y":89,"w":1230,"h":437},{"id":"refuseRearBody","name":"垃圾厢","file":"puzzle/rear-load-refuse-truck/refuseRearBody.webp","x":350,"y":4,"w":764,"h":343},{"id":"refuseRearPacker","name":"车尾填装器","file":"puzzle/rear-load-refuse-truck/refuseRearPacker.webp","x":1059,"y":0,"w":416,"h":407}],"number":32,"voiceLines":{"refuseRearIntro":"这是后装压缩式垃圾车。它从车尾收垃圾，把垃圾压紧再运走。","refuseRearChassis":"这是带驾驶室的底盘。司机开着车，沿街收运垃圾。","refuseRearBody":"这是垃圾厢。压紧的垃圾装在里面，跟着车一起运走。","refuseRearPacker":"这是车尾填装器。垃圾倒进料斗，刮板把它推入垃圾厢。"}},{"name":"拉臂式垃圾车","intro":"binLiftIntro","layers":["binLiftCab","binLiftBox","binLiftArm"],"id":"hooklift-refuse-truck","width":1384,"height":581,"parts":[{"id":"binLiftCab","name":"行驶底盘","file":"puzzle/hooklift-refuse-truck/binLiftCab.webp","x":0,"y":28,"w":1383,"h":553},{"id":"binLiftArm","name":"拉臂","file":"puzzle/hooklift-refuse-truck/binLiftArm.webp","x":370,"y":83,"w":990,"h":295},{"id":"binLiftBox","name":"可卸垃圾箱","file":"puzzle/hooklift-refuse-truck/binLiftBox.webp","x":430,"y":0,"w":954,"h":339}],"number":33,"voiceLines":{"binLiftIntro":"这是拉臂式垃圾车。它用拉臂钩住垃圾箱，把整只箱子拉上车。","binLiftCab":"这是行驶底盘。司机坐在驾驶室里，把车开到垃圾箱前面。","binLiftArm":"这是拉臂。钩头扣住垃圾箱，油缸就能带动拉臂把箱子拉上来。","binLiftBox":"这是可卸垃圾箱。箱子装满后，垃圾车能把它整个运走。"}},{"name":"密闭自卸垃圾车","intro":"sealedTipIntro","layers":["sealedTipBox","sealedTipCab"],"id":"sealed-refuse-tipper","width":1502,"height":609,"parts":[{"id":"sealedTipCab","name":"行驶底盘","file":"puzzle/sealed-refuse-tipper/sealedTipCab.webp","x":0,"y":35,"w":1502,"h":574},{"id":"sealedTipBox","name":"密闭垃圾厢","file":"puzzle/sealed-refuse-tipper/sealedTipBox.webp","x":431,"y":0,"w":1011,"h":392}],"number":34,"voiceLines":{"sealedTipIntro":"这是密闭自卸垃圾车。盖好车厢运走垃圾，卸车时再把车厢举起来。","sealedTipCab":"这是行驶底盘。车架托住垃圾厢，下面的油缸能把车厢前端顶起来。","sealedTipBox":"这是密闭垃圾厢。打开侧面的盖子就能装垃圾，卸车时垃圾从后门滑出去。"}},{"name":"夹桶式垃圾车","intro":"sidePackIntro","layers":["sidePackFrame","sidePackCab","sidePackBody"],"id":"integral-side-loader","width":1801,"height":730,"parts":[{"id":"sidePackFrame","name":"行驶底盘","file":"puzzle/integral-side-loader/sidePackFrame.webp","x":105,"y":440,"w":1696,"h":290},{"id":"sidePackCab","name":"车头","file":"puzzle/integral-side-loader/sidePackCab.webp","x":0,"y":53,"w":476,"h":553},{"id":"sidePackBody","name":"带夹桶臂的垃圾厢","file":"puzzle/integral-side-loader/sidePackBody.webp","x":496,"y":0,"w":1303,"h":526}],"number":35,"voiceLines":{"sidePackIntro":"这是侧装式垃圾车。车厢旁的夹桶臂举起垃圾桶，把垃圾倒进投料口。","sidePackFrame":"这是行驶底盘。车轮带着车架前进，车头和垃圾厢都装在上面。","sidePackCab":"这是车头。司机坐在驾驶室里，开着垃圾车沿街收垃圾。","sidePackBody":"这是带夹桶臂的垃圾厢。夹臂抱住垃圾桶，举起来往厢里倒。"}},{"name":"餐厨垃圾车","intro":"kitchenRunIntro","layers":["kitchenRunFrame","kitchenRunCab","kitchenRunTank"],"id":"kitchen-waste-collector","width":1463,"height":739,"parts":[{"id":"kitchenRunFrame","name":"行驶底盘","file":"puzzle/kitchen-waste-collector/kitchenRunFrame.webp","x":85,"y":403,"w":1378,"h":336},{"id":"kitchenRunCab","name":"车头","file":"puzzle/kitchen-waste-collector/kitchenRunCab.webp","x":0,"y":135,"w":458,"h":506},{"id":"kitchenRunTank","name":"餐厨垃圾罐","file":"puzzle/kitchen-waste-collector/kitchenRunTank.webp","x":487,"y":0,"w":966,"h":499}],"number":36,"voiceLines":{"kitchenRunIntro":"这是餐厨垃圾车。它去食堂和餐馆收集剩饭剩菜，装进罐里运走。","kitchenRunFrame":"这是行驶底盘。前后车轮带着车架，把装满的罐体稳稳托住。","kitchenRunCab":"这是车头。司机在这里开车，把车停到餐厨垃圾桶旁边。","kitchenRunTank":"这是收集罐。提桶架把剩饭剩菜倒进罐里，盖好盖子就能运走。"}},{"name":"摆臂式垃圾车","intro":"swingSkipIntro","layers":["swingSkipChassis","swingSkipBowl","swingSkipArms"],"id":"swing-arm-skip-truck","width":1888,"height":590,"parts":[{"id":"swingSkipChassis","name":"车身","file":"puzzle/swing-arm-skip-truck/swingSkipChassis.webp","x":0,"y":0,"w":1272,"h":590},{"id":"swingSkipArms","name":"带吊钩的摆臂","file":"puzzle/swing-arm-skip-truck/swingSkipArms.webp","x":817,"y":0,"w":937,"h":444},{"id":"swingSkipBowl","name":"船形垃圾斗","file":"puzzle/swing-arm-skip-truck/swingSkipBowl.webp","x":1266,"y":336,"w":622,"h":187}],"number":37,"voiceLines":{"swingSkipIntro":"这是摆臂式垃圾车。两根摆臂往后一摆，就能把垃圾斗吊上车。","swingSkipChassis":"这是车身。车尾的支腿撑住地面，让车子站稳。","swingSkipArms":"这是摆臂。吊钩挂住斗边，摆臂一抬，就能吊起垃圾斗。","swingSkipBowl":"这是船形垃圾斗。吊链钩住斗边的吊耳，就能把整斗垃圾运走。"}},{"name":"前装叉举式垃圾车","intro":"frontForkIntro","layers":["frontForkCarrier","frontForkBox"],"id":"front-fork-refuse-truck","width":1876,"height":584,"parts":[{"id":"frontForkCarrier","name":"叉举车身","file":"puzzle/front-fork-refuse-truck/frontForkCarrier.webp","x":0,"y":0,"w":1726,"h":563},{"id":"frontForkBox","name":"前装垃圾箱","file":"puzzle/front-fork-refuse-truck/frontForkBox.webp","x":1470,"y":388,"w":406,"h":196}],"foreground":{"part":"frontForkCarrier","withPart":"frontForkBox","insetPercent":[87.56660746003553,8.806488991888761,6.571936056838368,84.58864426419467]},"number":38,"voiceLines":{"frontForkIntro":"这是前装叉举式垃圾车。它从车头叉起垃圾箱，举过驾驶室，把垃圾倒进车厢。","frontForkCarrier":"这是带举升叉的车身。两根长臂抬起车叉，把垃圾箱稳稳举高。","frontForkBox":"这是前装垃圾箱。箱子两侧有叉套，车叉插进去，就能把它举起来。"}},{"name":"水罐消防车","intro":"fireTenderIntro","layers":["fireTenderFrame","fireTenderBody","fireTenderCab"],"id":"fire-water-tender","width":1477,"height":634,"parts":[{"id":"fireTenderFrame","name":"底盘","file":"puzzle/fire-water-tender/fireTenderFrame.webp","x":24,"y":378,"w":1453,"h":256},{"id":"fireTenderCab","name":"驾驶室","file":"puzzle/fire-water-tender/fireTenderCab.webp","x":0,"y":0,"w":449,"h":543},{"id":"fireTenderBody","name":"消防车厢","file":"puzzle/fire-water-tender/fireTenderBody.webp","x":438,"y":51,"w":1007,"h":337}],"number":39,"voiceLines":{"fireTenderIntro":"这是水罐消防车。它把水运到火场，用水泵把水送进消防水带。","fireTenderFrame":"这是底盘。车架托住驾驶室和车厢，车轮带着消防车前进。","fireTenderCab":"这是驾驶室。消防员坐在这里，开着消防车赶往火场。","fireTenderBody":"这是消防车厢。里面的水罐用来装水，水带可以接在旁边的出水口。"}},{"name":"云梯消防车","intro":"turnLadderIntro","layers":["turnLadderBase","turnLadderCab","turnLadderBasket","turnLadderBoom"],"id":"turntable-ladder-engine","width":1383,"height":689,"parts":[{"id":"turnLadderBase","name":"器材底盘","file":"puzzle/turntable-ladder-engine/turnLadderBase.webp","x":171,"y":401,"w":1212,"h":288},{"id":"turnLadderCab","name":"驾驶室","file":"puzzle/turntable-ladder-engine/turnLadderCab.webp","x":118,"y":152,"w":397,"h":457},{"id":"turnLadderBoom","name":"回转云梯","file":"puzzle/turntable-ladder-engine/turnLadderBoom.webp","x":171,"y":17,"w":1193,"h":394},{"id":"turnLadderBasket","name":"救援篮","file":"puzzle/turntable-ladder-engine/turnLadderBasket.webp","x":0,"y":0,"w":210,"h":194}],"number":40,"voiceLines":{"turnLadderIntro":"这是云梯消防车。它把云梯升高，让消防员到高处救人。","turnLadderBase":"这是器材底盘。两侧的柜子装着工具，车尾托着云梯。","turnLadderCab":"这是驾驶室。消防员坐在这里，开车前往救援现场。","turnLadderBoom":"这是回转云梯。它能转方向，把长梯伸向高处。","turnLadderBasket":"这是救援篮。它装在云梯顶端，消防员可以用它接人。"}}]